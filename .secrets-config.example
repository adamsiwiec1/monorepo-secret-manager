{
  "version": 3,
  "defaultEnv": "staging",
  "environments": {
    "development": {
      "provider": "local",
      "storePath": ".msm/store"
    },
    "staging": {
      "provider": "local",
      "storePath": ".msm/store"
    },
    "production": {
      "provider": "gcp",
      "projectId": "your-production-project-id",
      "credentials": {
        "path": "gcloud/production/service-account.json"
      }
    }
  },
  "shared": [
    {
      "kind": "env-file",
      "remoteName": "shared-env-file",
      "sourcePath": ".environments/.shared.{env}.env",
      "targetPath": ".env.shared"
    }
  ],
  "services": [
    {
      "name": "web",
      "package": "apps/web",
      "uses": [
        "shared-env-file"
      ],
      "secrets": [
        {
          "kind": "env-file",
          "remoteName": "web-env-file",
          "sourcePath": ".env.{env}",
          "targetPath": ".env"
        }
      ]
    },
    {
      "name": "api",
      "package": "apps/api",
      "uses": [
        "shared-env-file"
      ],
      "secrets": [
        {
          "kind": "env-file",
          "remoteName": "api-env-file",
          "sourcePath": ".env.{env}",
          "targetPath": ".env"
        },
        {
          "kind": "ssh-keypair",
          "remoteName": "api-deploy-ssh",
          "source": {
            "private": ".ssh/{env}.id_ed25519",
            "public": ".ssh/{env}.id_ed25519.pub"
          },
          "target": {
            "private": ".ssh/deploy",
            "public": ".ssh/deploy.pub"
          }
        }
      ]
    }
  ],
  "deletePolicy": {
    "maxVersions": 10,
    "maxAgeDays": 30,
    "enabled": true
  }
}
